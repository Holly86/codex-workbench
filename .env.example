# Copy to .env and adapt local paths. Do not add credentials to this file.
COMPOSE_PROJECT_NAME=codex-workbench
WORKBENCH_BIND_ADDRESS=0.0.0.0
WORKBENCH_PORT=8080
WORKBENCH_PUBLIC_ORIGIN=http://localhost:8080

# Explicit degraded HTTP mode for local/LAN evaluation only. For HTTPS set
# SESSION_COOKIE_SECURE=true and ALLOW_INSECURE_HTTP=false.
WORKBENCH_SESSION_COOKIE_SECURE=false
WORKBENCH_ALLOW_INSECURE_HTTP=true
WORKBENCH_SESSION_COOKIE_SAMESITE=strict
WORKBENCH_SESSION_IDLE_TIMEOUT_SECONDS=43200
WORKBENCH_SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800
WORKBENCH_LOGIN_RATE_LIMIT_ATTEMPTS=5
WORKBENCH_LOGIN_RATE_LIMIT_GLOBAL_ATTEMPTS=30
WORKBENCH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Host directories mounted into the Workbench services.
WORKSPACE_PATH=/workspace
WORKBENCH_DATA_PATH=./data
CODEX_HOME_PATH=/absolute/path/to/persistent/codex-home

# Align with the owner of bind-mounted files when needed.
WORKBENCH_UID=10001
WORKBENCH_GID=10001

# Pinned build inputs.
CODEX_VERSION=0.146.0
NODE_VERSION=24.18.1
PYTHON_VERSION=3.12.11
