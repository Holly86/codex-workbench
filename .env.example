# Public production template. Copy to .env; never commit the resulting file.
COMPOSE_PROJECT_NAME=codex-workbench
# Docker Hub distribution settings. Replace the namespace before using compose.release.yaml.
DOCKERHUB_NAMESPACE=<your-dockerhub-namespace>
WORKBENCH_VERSION=0.2.2
# Source builds use this local image tag and do not publish it.
WORKBENCH_IMAGE_TAG=local

# The only published port is fixed at 127.0.0.1:8085:8080. Set the exact external HTTPS origin
# served by your reverse proxy; the reserved .invalid name must be replaced.
WORKBENCH_PUBLIC_ORIGIN=https://workbench.example.invalid

# Regular operation requires HTTPS at the reverse proxy. The only permitted HTTP configuration is
# a host-local test with WORKBENCH_PUBLIC_ORIGIN=http://127.0.0.1:8085,
# WORKBENCH_SESSION_COOKIE_SECURE=false and WORKBENCH_ALLOW_INSECURE_HTTP=true.
WORKBENCH_SESSION_COOKIE_SECURE=true
WORKBENCH_ALLOW_INSECURE_HTTP=false
WORKBENCH_SESSION_COOKIE_SAMESITE=strict
WORKBENCH_SESSION_IDLE_TIMEOUT_SECONDS=43200
WORKBENCH_SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800
WORKBENCH_LOGIN_RATE_LIMIT_ATTEMPTS=5
WORKBENCH_LOGIN_RATE_LIMIT_GLOBAL_ATTEMPTS=30
WORKBENCH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
WORKBENCH_LOG_LEVEL=INFO

# Managed Codex app-server process (build, generated schemas, and runtime must remain 0.146.0).
WORKBENCH_APP_SERVER_REQUEST_TIMEOUT_SECONDS=30
WORKBENCH_APP_SERVER_SHUTDOWN_TIMEOUT_SECONDS=5
WORKBENCH_APP_SERVER_MAX_LINE_BYTES=4194304
WORKBENCH_APP_SERVER_RESTART_LIMIT=5
WORKBENCH_APP_SERVER_RESTART_WINDOW_SECONDS=300
WORKBENCH_APP_SERVER_BACKOFF_INITIAL_SECONDS=0.5
WORKBENCH_APP_SERVER_BACKOFF_MAX_SECONDS=30
WORKBENCH_APP_SERVER_BACKOFF_JITTER_RATIO=0.15
WORKBENCH_APP_SERVER_WATCHDOG_ENABLED=true
WORKBENCH_APP_SERVER_WATCHDOG_IDLE_SECONDS=45
WORKBENCH_APP_SERVER_WATCHDOG_TIMEOUT_SECONDS=8
WORKBENCH_APP_SERVER_WATCHDOG_FAILURE_THRESHOLD=3
WORKBENCH_SQLITE_BUSY_TIMEOUT_MS=5000
WORKBENCH_STORAGE_WARNING_FREE_BYTES=536870912
# Optional plugin/list discovery is intentionally outside the critical startup path.
WORKBENCH_PLUGIN_DISCOVERY_ENABLED=false

# Realtime, approvals, and state-changing API limits.
WORKBENCH_REALTIME_HISTORY_SIZE=512
WORKBENCH_REALTIME_CLIENT_QUEUE_SIZE=128
WORKBENCH_REALTIME_HEARTBEAT_SECONDS=20
WORKBENCH_APPROVAL_TTL_SECONDS=300
WORKBENCH_FULL_ACCESS_CONFIRMATION_TTL_SECONDS=120
WORKBENCH_MUTATION_RATE_LIMIT_REQUESTS=120
WORKBENCH_MUTATION_RATE_LIMIT_GLOBAL_REQUESTS=1000
WORKBENCH_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
WORKBENCH_MAX_COMMAND_OUTPUT_BYTES=262144
# Short local Git commands remain tightly bounded. Network operations and clones have separate,
# longer limits for slower NAS storage and real remote repositories.
WORKBENCH_GIT_COMMAND_TIMEOUT_SECONDS=30
WORKBENCH_GIT_NETWORK_TIMEOUT_SECONDS=300
WORKBENCH_GIT_CLONE_TIMEOUT_SECONDS=900

# Private image uploads. Animated/multipart images are rejected (one frame only).
WORKBENCH_MAX_JSON_REQUEST_BYTES=1048576
WORKBENCH_MAX_UPLOAD_BYTES=20971520
WORKBENCH_MAX_UPLOADS_PER_TURN=8
WORKBENCH_MAX_UPLOADS_PER_SESSION=64
WORKBENCH_MAX_UPLOAD_SESSION_BYTES=104857600
WORKBENCH_UPLOAD_TTL_SECONDS=86400
WORKBENCH_UPLOAD_MAX_DIMENSION=12000
WORKBENCH_UPLOAD_MAX_PIXELS=40000000

# Example absolute Synology bind mounts. Adjust them for your host; never use anonymous volumes for
# state, credentials, CODEX_HOME, or the workspace. Despite its legacy name,
# WORKBENCH_PASSWORD_PATH is the persistent security mount for both the password verifier and
# repository-scoped deploy-key material. Back it up and protect it as credential storage.
WORKBENCH_DATA_PATH=/volume1/docker/codex/workbench/data
WORKBENCH_UPLOADS_PATH=/volume1/docker/codex/workbench/uploads
WORKBENCH_PASSWORD_PATH=/volume1/docker/codex/workbench/secrets/password
WORKBENCH_SESSION_SECRET_PATH=/volume1/docker/codex/workbench/secrets/session
CODEX_HOME_PATH=/volume1/docker/codex/config/.codex
WORKSPACE_PATH=/volume1/docker/codex/workspace

# Set these to the numeric owner/group of the host workspace and Codex home (for example `id -u`
# and `id -g`). The generic defaults are not credentials and must be verified for your NAS.
PUID=1000
PGID=1000

# Pinned build inputs. CODEX_VERSION is also enforced by the backend at runtime.
CODEX_VERSION=0.146.0
NODE_VERSION=24.18.1
PYTHON_VERSION=3.12.11
