# Deny everything, then admit only files referenced by the two Dockerfiles.
# This prevents local state from entering any build layer even if a future COPY is broad.
**

!backend/
!backend/pyproject.toml
!backend/README.md
!backend/src/
!backend/src/**

!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/eslint.config.js
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**

!deploy/
!deploy/backend.Dockerfile
!deploy/frontend.Dockerfile
!deploy/nginx.conf
!deploy/verify-codex-runtime.sh
